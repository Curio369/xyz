import numpy as np
import pandas as pd
import matplotlib.pyplot as plt


def design_matrix(X):
    X = np.asarray(X, dtype=float)
    if X.ndim == 1:
        X = X.reshape(-1, 1)
    return np.hstack([np.ones((X.shape[0], 1)), X])


def standardise(X_train, X_other):
    mu = X_train.mean(axis=0)
    sd = X_train.std(axis=0)
    sd = np.where(sd == 0, 1, sd)
    return (X_train - mu) / sd, (X_other - mu) / sd


def pairwise_distances(A, B):
    A = np.asarray(A, dtype=float); B = np.asarray(B, dtype=float)
    diff = A[:, None, :] - B[None, :, :]
    return np.sqrt(np.sum(diff ** 2, axis=2))


def confusion_matrix(y_true, y_pred):
    y_true = np.asarray(y_true);
    y_pred = np.asarray(y_pred)
    tp = np.sum((y_true == 1) & (y_pred == 1))
    tn = np.sum((y_true == 0) & (y_pred == 0))
    fp = np.sum((y_true == 0) & (y_pred == 1))
    fn = np.sum((y_true == 1) & (y_pred == 0))
    return tp, tn, fp, fn


def accuracy(y_true, y_pred):
    return np.mean(np.asarray(y_true) == np.asarray(y_pred))


def precision(y_true, y_pred):
    tp, tn, fp, fn = confusion_matrix(y_true, y_pred)
    return tp / (tp + fp) if tp + fp > 0 else 0.0


def recall(y_true, y_pred):
    tp, tn, fp, fn = confusion_matrix(y_true, y_pred)
    return tp / (tp + fn) if tp + fn > 0 else 0.0


def f1_score(y_true, y_pred):
    p, r = precision(y_true, y_pred), recall(y_true, y_pred)
    return 2 * p * r / (p + r) if p + r > 0 else 0.0


def report(y_true, y_pred):
    tp, tn, fp, fn = confusion_matrix(y_true, y_pred)
    print("TP:", tp, " TN:", tn, " FP:", fp, " FN:", fn)
    print("accuracy :", round(accuracy(y_true, y_pred), 3))
    print("precision:", round(precision(y_true, y_pred), 3))
    print("recall   :", round(recall(y_true, y_pred), 3))
    print("F1       :", round(f1_score(y_true, y_pred), 3))


def rmse(y_true, y_pred):
    return np.sqrt(np.mean((y_true - y_pred) ** 2))


def sigmoid(z):
    return 1 / (1 + np.exp(-z))


def fit_simple_lr(x, y):
    xb, yb = x.mean(), y.mean()
    w = ((x - xb) * (y - yb)).sum() / ((x - xb) ** 2).sum()
    b = yb - w * xb
    return w, b


def fit_normal_equation(X, y):
    A = design_matrix(X)
    return np.linalg.solve(A.T @ A, A.T @ y)


def r2_score_scratch(y_true, y_pred):
    ss_res = np.sum((y_true - y_pred) ** 2)
    ss_tot = np.sum((y_true - y_true.mean()) ** 2)
    return 1 - ss_res / ss_tot


def fit_gradient_descent(X, y, lr, n_iters):
    A = design_matrix(X)
    n = len(y)
    theta = np.zeros(A.shape[1])
    losses = []
    for _ in range(n_iters):
        r = A @ theta - y
        losses.append(np.mean(r ** 2))
        theta = theta - lr * (2 / n) * A.T @ r
    return theta, losses


def fit_ridge(X, y, lam):
    A = design_matrix(X)
    I = np.eye(A.shape[1])
    I[0, 0] = 0
    return np.linalg.solve(A.T @ A + lam * I, A.T @ y)


def k_fold_cv(X, y, lam, k=5, seed=0):
    idx = np.random.default_rng(seed).permutation(len(y))
    folds = np.array_split(idx, k)
    scores = []
    for i in range(k):
        val = folds[i]
        trn = np.concatenate([folds[j] for j in range(k) if j != i])
        theta = fit_ridge(X[trn], y[trn], lam)
        scores.append(rmse(y[val], design_matrix(X[val]) @ theta))
    return np.mean(scores)


def log_likelihood(X, y, theta):
    h = sigmoid(design_matrix(X) @ theta)
    eps = 1e-12
    return np.sum(y * np.log(h + eps) + (1 - y) * np.log(1 - h + eps))


def fit_logistic(X, y, lr=0.1, n_iters=2000):
    A = design_matrix(X)
    m = len(y)
    theta = np.zeros(A.shape[1])
    history = []
    for _ in range(n_iters):
        h = sigmoid(A @ theta)
        theta = theta + (lr / m) * A.T @ (y - h)
        history.append(log_likelihood(X, y, theta))
    return theta, history


def roc_curve_scratch(y_true, p):
    thresholds = np.concatenate([[np.inf], np.sort(p)[::-1]])
    P = np.sum(y_true == 1); N = np.sum(y_true == 0)
    fpr, tpr = [], []
    for t in thresholds:
        tp, tn, fp, fn = confusion_matrix(y_true, (p >= t).astype(int))
        tpr.append(tp / P)
        fpr.append(fp / N)
    return np.array(fpr), np.array(tpr)


def auc_trapezoid(fpr, tpr):
    order = np.argsort(fpr, kind="stable")
    fpr, tpr = fpr[order], tpr[order]
    return np.sum((fpr[1:] - fpr[:-1]) * (tpr[1:] + tpr[:-1]) / 2)


def gaussian_pdf(x, mu, var):
    return np.exp(-(x - mu) ** 2 / (2 * var)) / np.sqrt(2 * np.pi * var)


def fit_gaussian_nb(X, y):
    classes = [0, 1]
    priors    = np.array([np.mean(y == c) for c in classes])
    means     = np.array([X[y == c].mean(axis=0) for c in classes])
    variances = np.array([X[y == c].var(axis=0) for c in classes])
    return priors, means, variances


def predict_proba_nb(X, priors, means, variances):
    L = np.zeros((X.shape[0], 2))
    for c in range(2):
        L[:, c] = np.log(priors[c]) + np.log(gaussian_pdf(X, means[c], variances[c])).sum(axis=1)
    return sigmoid(L[:, 1] - L[:, 0])


def knn_predict(X_train, y_train, X_query, k):
    D = pairwise_distances(X_query, X_train)
    nn = np.argsort(D, axis=1, kind="stable")[:, :k]
    return (y_train[nn].mean(axis=1) > 0.5).astype(int)


def k_fold_cv_knn(X, y, k, folds=5, seed=0):
    parts = np.array_split(np.random.default_rng(seed).permutation(len(y)), folds)
    accs = []
    for i in range(folds):
        val = parts[i]
        trn = np.concatenate([parts[j] for j in range(folds) if j != i])
        accs.append(accuracy(y[val], knn_predict(X[trn], y[trn], X[val], k)))
    return np.mean(accs)


def knn_predict_weighted(X_train, y_train, X_query, k, eps=1e-9):
    D = pairwise_distances(X_query, X_train)
    nn = np.argsort(D, axis=1, kind="stable")[:, :k]
    w = 1 / (np.take_along_axis(D, nn, axis=1) + eps)
    return ((w * y_train[nn]).sum(axis=1) / w.sum(axis=1) > 0.5).astype(int)


def random_init(X, K, seed):
    idx = np.random.default_rng(seed).choice(len(X), K, replace=False)
    return X[idx]


def assign_clusters(X, centroids):
    return np.argmin(pairwise_distances(X, centroids), axis=1)


def update_centroids(X, labels, centroids):
    new = np.array(centroids, dtype=float)
    for k in range(len(centroids)):
        pts = X[labels == k]
        if len(pts) > 0:
            new[k] = pts.mean(axis=0)
    return new


def distortion(X, labels, centroids):
    return np.sum((X - centroids[labels]) ** 2)


def kmeans(X, init_centroids, max_iter=100):
    X = np.asarray(X, dtype=float)
    centroids = np.array(init_centroids, dtype=float)
    for it in range(1, max_iter + 1):
        labels = assign_clusters(X, centroids)
        new = update_centroids(X, labels, centroids)
        if np.allclose(new, centroids):
            centroids = new
            break
        centroids = new
    labels = assign_clusters(X, centroids)
    return centroids, labels, distortion(X, labels, centroids), it


def best_of_kmeans(X, K, n_init=10):
    best = None
    for seed in range(n_init):
        res = kmeans(X, random_init(X, K, seed))
        if best is None or res[2] < best[2]:
            best = res
    return best


def kmeans_pp_init(X, K, seed):
    rng = np.random.default_rng(seed)
    centroids = [X[rng.integers(len(X))]]
    for _ in range(K - 1):
        d2 = np.min(pairwise_distances(X, np.array(centroids)), axis=1) ** 2
        centroids.append(X[rng.choice(len(X), p=d2 / d2.sum())])
    return np.array(centroids)

